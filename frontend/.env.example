# NETRA Frontend Environment Variables
#
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local

# Demo mode toggle:
#   "1" = Interactive demo mode using deterministic mock fixtures (zero network calls, safe for public demo URLs)
#   "0" (or any value !== "1") = Live AWS backend mode connecting to API Gateway (requires NEXT_PUBLIC_API_BASE)
NEXT_PUBLIC_DEMO=1

# API Gateway base URL:
#   Required when NEXT_PUBLIC_DEMO !== "1".
#   When running in live mode, if this variable is unset, the application throws a startup error naming NEXT_PUBLIC_API_BASE.
#   Get this from `make outputs` or CloudFormation stack outputs after deploying the SAM stack.
#   Example: https://abc123xyz.execute-api.ap-south-1.amazonaws.com
# NEXT_PUBLIC_API_BASE=https://<your-api-id>.execute-api.ap-south-1.amazonaws.com
