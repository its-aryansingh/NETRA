# NETRA Frontend Environment Variables
#
# Copy this file to .env.local and fill in your values.
#   cp .env.example .env.local

# Demo mode: "1" = fixture data, no network calls (safe for public URLs)
#             "0" = live AWS backend, requires NEXT_PUBLIC_API_BASE
NEXT_PUBLIC_DEMO=1

# API Gateway base URL (required when NEXT_PUBLIC_DEMO=0)
# Get this from `make outputs` after deploying the SAM stack.
# Example: https://abc123xyz.execute-api.ap-south-1.amazonaws.com
# NEXT_PUBLIC_API_BASE=https://<your-api-id>.execute-api.ap-south-1.amazonaws.com
