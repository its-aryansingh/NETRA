# CloudFormation Guard rules for NETRA infrastructure security
# Enforces encryption, least-privilege, and compliance standards

# Rule 1: All DynamoDB tables must use pay-per-request billing
let dynamodb_tables = Resources.*[ Type == 'AWS::DynamoDB::Table' ]
rule dynamodb_pay_per_request when %dynamodb_tables !empty {
    %dynamodb_tables.Properties.BillingMode == 'PAY_PER_REQUEST'
        <<DynamoDB tables must use PAY_PER_REQUEST billing mode to avoid over-provisioning>>
}

# Rule 2: All Lambda functions must have a timeout configured
let lambda_functions = Resources.*[ Type == 'AWS::Serverless::Function' ]
rule lambda_timeout_configured when %lambda_functions !empty {
    %lambda_functions.Properties.Timeout <= 300 when %lambda_functions.Properties.Timeout exists
        <<Lambda timeout must not exceed 300 seconds for cost safety>>
}
rule global_lambda_timeout_configured when Globals.Function.Timeout exists {
    Globals.Function.Timeout <= 300
        <<Global Lambda timeout must not exceed 300 seconds for cost safety>>
}

# Rule 3: SQS queues must have a dead-letter queue configured
let sqs_queues = Resources.*[ Type == 'AWS::SQS::Queue' ]
rule sqs_dlq_configured when %sqs_queues !empty {
    some %sqs_queues.Properties.RedrivePolicy exists
        <<At least one SQS queue must have a RedrivePolicy (dead-letter queue) for fault tolerance>>
}

# Rule 4: SNS topics must have a display name
let sns_topics = Resources.*[ Type == 'AWS::SNS::Topic' ]
rule sns_display_name when %sns_topics !empty {
    %sns_topics.Properties.DisplayName exists
        <<SNS topics must have a DisplayName for operational clarity>>
}

# Rule 5: S3 buckets must not have public access
let s3_buckets = Resources.*[ Type == 'AWS::S3::Bucket' ]
rule s3_no_public_access when %s3_buckets !empty {
    %s3_buckets.Properties.PublicAccessBlockConfiguration exists
        <<S3 buckets must have PublicAccessBlockConfiguration to prevent public exposure>>
}
