# NETRA Environment Configuration

# AWS Target Region
AWS_REGION=ap-south-1
NETRA_REGION=ap-south-1

# Pricing API Region (Must be us-east-1 for AWS Price List API)
NETRA_PRICING_REGION=us-east-1

# Currency Constant (USD to INR conversion, fixed constant)
NETRA_USD_INR=88.50

# DynamoDB Table Overrides (Defaults configured in SAM template)
NETRA_TABLE_BURN_SNAPSHOTS=netra_burn_snapshots
NETRA_TABLE_PRICE_CACHE=netra_price_cache
NETRA_TABLE_FINDINGS=netra_findings
NETRA_TABLE_AUDIT_LOG=netra_audit_log

# Logging & Observability
NETRA_LOG_LEVEL=INFO
STRANDS_OTEL_ENABLE=true

# AI Model Configuration (bedrock | ollama)
NETRA_MODEL_PROVIDER=bedrock
BEDROCK_MODEL_ID=apac.anthropic.claude-sonnet-4-5-20250929-v1:0

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_DEMO=1
